{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/monitoramento-de-emissoes-fugitivas",
      "destination": "https://www.monitorarconsultoria.com.br/servicos/emissoes-fugitivas",
      "permanent": true
    },
    {
      "source": "/monitoramento-de-emissoes-fugitivas.html",
      "destination": "https://www.monitorarconsultoria.com.br/servicos/emissoes-fugitivas",
      "permanent": true
    },
    {
      "source": "/engenharia-ambiental",
      "destination": "https://www.monitorarconsultoria.com.br/servicos",
      "permanent": true
    },
    {
      "source": "/engenharia-ambiental.html",
      "destination": "https://www.monitorarconsultoria.com.br/servicos",
      "permanent": true
    },
    {
      "source": "/engenharia-do-trabalho",
      "destination": "https://www.monitorarconsultoria.com.br/servicos/seguranca",
      "permanent": true
    },
    {
      "source": "/engenharia-do-trabalho.html",
      "destination": "https://www.monitorarconsultoria.com.br/servicos/seguranca",
      "permanent": true
    },
    {
      "source": "/quem-somos",
      "destination": "https://www.monitorarconsultoria.com.br/sobre",
      "permanent": true
    },
    {
      "source": "/quem-somos.html",
      "destination": "https://www.monitorarconsultoria.com.br/sobre",
      "permanent": true
    },
    {
      "source": "/missao-e-visao",
      "destination": "https://www.monitorarconsultoria.com.br/sobre",
      "permanent": true
    },
    {
      "source": "/missao-e-visao.html",
      "destination": "https://www.monitorarconsultoria.com.br/sobre",
      "permanent": true
    },
    {
      "source": "/nosso-valores",
      "destination": "https://www.monitorarconsultoria.com.br/sobre",
      "permanent": true
    },
    {
      "source": "/nosso-valores.html",
      "destination": "https://www.monitorarconsultoria.com.br/sobre",
      "permanent": true
    },
    {
      "source": "/perfuracao-e-instalacao-de-pocos-de-monitoramento-ambiental",
      "destination": "https://www.monitorarconsultoria.com.br/servicos",
      "permanent": true
    },
    {
      "source": "/perfuracao-e-instalacao-de-pocos-de-monitoramento-ambiental.html",
      "destination": "https://www.monitorarconsultoria.com.br/servicos",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "monitorarconsultoria.com.br"
        }
      ],
      "destination": "https://www.monitorarconsultoria.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/pagina/1",
      "destination": "/blog",
      "permanent": true
    }
  ]
}
